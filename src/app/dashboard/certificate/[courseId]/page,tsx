import Link from "next/link";
import { notFound, redirect } from "next/navigation";
import { requireRole } from "@/lib/auth";
import PrintButton from "@/components/PrintButton";

export default async function Certificate({ params }: { params: Promise<{ courseId: string }> }) {
  const { courseId } = await params;
  const { sb, user, profile } = await requireRole(["student", "instructor", "admin"]);

  const { data: course } = await sb.from("courses").select("id, title, profiles(full_name)").eq("id", courseId).maybeSingle();
  if (!course) notFound();
  const { data: enr } = await sb.from("enrollments").select("id").eq("course_id", courseId).eq("student_id", user.id).maybeSingle();
  if (!enr) redirect("/dashboard");

  const { data: les } = await sb.from("lessons").select("id").eq("course_id", courseId);
  const { data: prog } = await sb
    .from("lesson_progress")
    .select("completed_at")
    .eq("student_id", user.id)
    .eq("course_id", courseId)
    .eq("completed", true);
  const total = les?.length ?? 0;
  if (!total || (prog?.length ?? 0) < total) redirect(`/dashboard/courses#c-${courseId}`);

  const last = (prog ?? []).map((p: any) => p.completed_at as string).filter(Boolean).sort().pop();
  const date = new Date(last ?? Date.now()).toLocaleDateString("en-GB", {
    day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Karachi",
  });
  const student = profile.full_name ?? user.email ?? "Student";
  const teacher = (course.profiles as any)?.full_name ?? "Knowlix instructor";
  const number = `KNX-${String(enr.id).slice(0, 8).toUpperCase()}`;

  return (
    <div className="bg-slate-100 px-4 py-10">
      <style>{`@media print{header,footer,.no-print{display:none!important}body{background:#fff!important}@page{size:A4 landscape;margin:0}.cert{box-shadow:none!important;margin:0!important;max-width:none!important}}`}</style>

      <div className="no-print mx-auto mb-6 flex max-w-4xl items-center justify-between gap-3">
        <Link href={`/dashboard/courses#c-${courseId}`} className="text-sm font-semibold text-brand">← Back to course</Link>
        <PrintButton />
      </div>

      <div className="cert mx-auto max-w-4xl bg-white p-3 shadow-xl">
        <div className="border-[6px] border-double border-brand p-3">
          <div className="border border-slate-300 px-8 py-12 text-center">
            <p className="text-sm font-bold tracking-[0.3em] text-brand">KNOWLIX</p>
            <h1 className="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 md:text-5xl">Certificate of Completion</h1>
            <p className="mt-8 text-slate-500">This is to certify that</p>
            <p className="mt-3 border-b border-slate-300 pb-3 text-4xl font-bold text-slate-900">{student}</p>
            <p className="mt-6 text-slate-500">has successfully completed all lessons of the course</p>
            <p className="mt-3 text-2xl font-bold text-brand">{course.title}</p>

            <div className="mt-12 grid grid-cols-3 gap-6 text-sm">
              <div>
                <p className="border-t border-slate-300 pt-2 font-semibold text-slate-900">{date}</p>
                <p className="text-slate-500">Date of completion</p>
              </div>
              <div>
                <p className="border-t border-slate-300 pt-2 font-semibold text-slate-900">{teacher}</p>
                <p className="text-slate-500">Instructor</p>
              </div>
              <div>
                <p className="border-t border-slate-300 pt-2 font-semibold text-slate-900">{number}</p>
                <p className="text-slate-500">Certificate no.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p className="no-print mt-4 text-center text-xs text-slate-500">Tip: in the print window choose “Save as PDF”.</p>
    </div>
  );
}