# Knowlix LMS - Environment Configuration Template
# Duplicate this file as .env.local and fill with your Supabase project credentials.

# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (Public - client-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
